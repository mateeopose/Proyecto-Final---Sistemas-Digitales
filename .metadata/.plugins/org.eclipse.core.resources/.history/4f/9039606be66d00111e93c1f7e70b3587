#include "Conecta3.h"
#include "Leds.h"

// ESTE ES EL CEREBRO: La matriz virtual que recuerda dónde están las fichas.
// Es privada (static) para que nadie la toque desde afuera por accidente.
static uint8_t tablero[8][4];

// Prepara el tablero virtual y apaga las luces
void Juego_Init(void) {
    for (int fila = 0; fila < 8; fila++) {
        for (int col = 0; col < 4; col++) {
            tablero[fila][col] = VACIO;
        }
    }
    Matriz_Init(); // Limpiamos la memoria de los LEDs también
}

// Simula la gravedad: La ficha cae hasta el primer lugar vacío desde abajo
// Retorna 1 si pudo colocar la ficha, o 0 si la columna estaba llena.
uint8_t Juego_SoltarFicha(uint8_t columna, uint8_t jugador) {

    // Protección anti-cuelgues por si pasamos una columna que no existe
    if (columna > 3) return 0;

    // Revisamos la columna desde abajo (fila 7) hacia arriba (fila 0)
    for (int8_t fila = 7; fila >= 0; fila--) {

        // ¿Encontramos un espacio vacío?
        if (tablero[fila][columna] == VACIO) {

            // 1. Guardamos la ficha en el cerebro (matriz virtual)
            tablero[fila][columna] = jugador;

            // 2. Mandamos la orden a los ojos (matriz LED)
            if (jugador == JUGADOR_1) {
                Matriz_SetLed(fila, columna, 100, 0, 0); // Rojo
            } else if (jugador == JUGADOR_2) {
                Matriz_SetLed(fila, columna, 0, 100, 0); // Verde
            }

            // 3. Disparamos el DMA para que se vea el cambio
            Matriz_Update();

            return 1; // Ficha colocada con éxito
        }
    }

    // Si el for terminó y no encontró ningún lugar vacío, la columna está llena
    return 0;
}
