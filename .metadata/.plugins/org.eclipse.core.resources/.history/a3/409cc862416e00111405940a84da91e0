/**
 * @file    Conecta3.c
 * @brief   Implementación del motor lógico y renderizado visual.
 * @details Gestiona la matriz virtual, la gravedad de las fichas,
 * la detección de victoria mediante escaneo de patrones
 * y la máquina de estados temporal para animaciones no bloqueantes.
 */

#include "Conecta3.h"
#include "Leds.h"
#include "stm32f4xx_hal.h"

/* Variables de estado del juego */
static uint8_t tablero[8][4];
static uint8_t turno_actual = JUGADOR_1;
static uint8_t juego_terminado = 0;

/* Variables de la máquina de estados de animación */
static uint8_t animacion_activa = 0;
static uint8_t anim_fila_actual = 0;
static uint8_t anim_fila_destino = 0;
static uint8_t anim_columna = 0;
static uint8_t anim_jugador = 0;
static uint32_t anim_tiempo_anterior = 0;

/**
 * @brief  Escanea el tablero en búsqueda de 3 fichas alineadas.
 * @retval Retorna el ID del jugador ganador (1 o 2), o 0 si no hay ganador.
 */
static uint8_t VerificarGanador(void) {
    // 1. Verificación de patrones Verticales (Comienza en fila 1)
    for (int col = 0; col < 4; col++) {
        for (int fila = 1; fila <= 5; fila++) {
            uint8_t ficha = tablero[fila][col];
            if (ficha != VACIO &&
                ficha == tablero[fila + 1][col] &&
                ficha == tablero[fila + 2][col]) {
                return ficha;
            }
        }
    }

    // 2. Verificación de patrones Horizontales (Comienza en fila 1)
    for (int fila = 1; fila < 8; fila++) {
        for (int col = 0; col <= 1; col++) {
            uint8_t ficha = tablero[fila][col];
            if (ficha != VACIO &&
                ficha == tablero[fila][col + 1] &&
                ficha == tablero[fila][col + 2]) {
                return ficha;
            }
        }
    }

    // 3. Verificación de patrones Diagonales hacia la derecha (Comienza en fila 1)
    for (int fila = 1; fila <= 5; fila++) {
        for (int col = 0; col <= 1; col++) {
            uint8_t ficha = tablero[fila][col];
            if (ficha != VACIO &&
                ficha == tablero[fila + 1][col + 1] &&
                ficha == tablero[fila + 2][col + 2]) {
                return ficha;
            }
        }
    }

    // 4. Verificación de patrones Diagonales hacia la izquierda (Comienza en fila 1)
    for (int fila = 1; fila <= 5; fila++) {
        for (int col = 2; col < 4; col++) {
            uint8_t ficha = tablero[fila][col];
            if (ficha != VACIO &&
                ficha == tablero[fila + 1][col - 1] &&
                ficha == tablero[fila + 2][col - 2]) {
                return ficha;
            }
        }
    }

    return 0; // Condición de victoria no cumplida
}

/**
 * @brief Inicializa o reinicia el estado lógico y visual del juego.
 */
void Juego_Init(void) {
    turno_actual = JUGADOR_1;
    animacion_activa = 0;
    juego_terminado = 0;

    // Limpieza de la matriz virtual y el buffer físico de LEDs
    for (int fila = 0; fila < 8; fila++) {
        for (int col = 0; col < 4; col++) {
            tablero[fila][col] = VACIO;
            Matriz_SetLed(fila, col, 0, 0, 0);
        }
    }

    // Fuerza la transmisión DMA para apagar la pantalla inmediatamente
    Matriz_Update();
}

uint8_t Juego_ObtenerTurno(void) {
    return turno_actual;
}

/**
 * @brief  Procesa la solicitud de inserción de una nueva ficha.
 * @param  columna Índice de la columna seleccionada (0 a 3).
 */
void Juego_Jugar(uint8_t columna) {
    // Se rechazan entradas si el juego concluyó o hay un renderizado en proceso
    if (juego_terminado == 1 || animacion_activa == 1 || columna > 3) {
        return;
    }

    // Cálculo de la física (gravedad): determinación de la fila de reposo
    int8_t fila_destino = -1;
    for (int8_t fila = 7; fila >= 0; fila--) {
        if (tablero[fila][columna] == VACIO) {
            fila_destino = fila;
            break;
        }
    }

    // Si la columna posee espacio disponible, se inicializa la animación
    // Cálculo de la física (gravedad): determinación de la fila de reposo.
        // MODIFICADO: Ahora el "techo" del juego es la fila 1 (la 0 es el menú).
        int8_t fila_destino = -1;
        for (int8_t fila = 7; fila >= 1; fila--) {
            if (tablero[fila][columna] == VACIO) {
                fila_destino = fila;
                break;
            }
        }

        // Si la columna posee espacio disponible, se inicializa la animación
        if (fila_destino != -1) {
            anim_fila_destino = fila_destino;
            anim_columna = columna;
            anim_jugador = turno_actual;

            // MODIFICADO: La animación nace en la fila 1, debajo del menú
            anim_fila_actual = 1;

            anim_tiempo_anterior = HAL_GetTick();
            animacion_activa = 1;
        }
}

/**
 * @brief Tarea periódica de renderizado no bloqueante.
 * @note  Debe ser llamada de forma continua en el bucle principal (super-loop).
 */
void Juego_Actualizar(void) {
    if (animacion_activa == 0) return;

    // Control de la tasa de refresco (framerate) de la caída a 100ms
    if (HAL_GetTick() - anim_tiempo_anterior >= 100) {
        anim_tiempo_anterior = HAL_GetTick();

        // 1. Renderizado estático (fichas ya consolidadas en el tablero)
        for (int f = 0; f < 8; f++) {
            for (int c = 0; c < 4; c++) {
                if (tablero[f][c] == JUGADOR_1) {
                    Matriz_SetLed(f, c, 100, 0, 0);
                } else if (tablero[f][c] == JUGADOR_2) {
                    Matriz_SetLed(f, c, 0, 100, 0);
                } else {
                    Matriz_SetLed(f, c, 0, 0, 0);
                }
            }
        }

        // 2. Renderizado dinámico (ficha en movimiento)
        if (anim_jugador == JUGADOR_1) {
            Matriz_SetLed(anim_fila_actual, anim_columna, 100, 0, 0);
        } else {
            Matriz_SetLed(anim_fila_actual, anim_columna, 0, 100, 0);
        }

        // Transmisión de la trama de datos por DMA
        Matriz_Update();

        // 3. Evaluación de colisión y actualización de estado
        if (anim_fila_actual == anim_fila_destino) {

            // Consolidación de la ficha en la matriz virtual
            tablero[anim_fila_destino][anim_columna] = anim_jugador;
            animacion_activa = 0;

            // Verificación de condición de fin de partida
            uint8_t ganador = VerificarGanador();
            if (ganador != 0) {
                juego_terminado = 1;
            } else {
                // Alternancia de turnos
                turno_actual = (turno_actual == JUGADOR_1) ? JUGADOR_2 : JUGADOR_1;
            }
        } else {
            // Incremento de la posición para el siguiente fotograma
            anim_fila_actual++;
        }
    }
}
